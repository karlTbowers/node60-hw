# Node60 workstation: the reference environment, captured on 2026-11-03 from the M3 MacBook Air
# (Mac15,13, 4 P + 4 E cores, 24 GB, macOS 26.4 build 25E246). Sourced by scripts/setup-workstation.sh.
# "pinned" = the script installs exactly this; "recorded" = Homebrew can't install an old version,
# so the script installs the current one and reports any difference.

# --- recorded only ---
REF_MACOS=26.4
REF_CLT=26.4.0.0.1774242506          # Command Line Tools (git, /usr/bin/python3 3.9.6)
REF_BREW=7.0.12
REF_UV=0.13.7
REF_NODE=26.13.0
REF_NPM=11.20.0
REF_GH=2.103.3
REF_GIT_LFS=3.8.1
REF_CLAUDE=2.1.314                   # Claude Code CLI (~/.local/bin/claude, its own installer)

# Homebrew packages the process needs (always installed). poppler: pdftotext/pdftoppm for the
# handbook's enclosure-drawing skill and the library's part scripts; git-lfs: dropout-vendor-docs.
BREW_FORMULAE="gh uv node git-lfs poppler"
# The rest of the reference Mac's on-request Homebrew packages, not used by the design process
# (installed only with --extras).
BREW_EXTRA_FORMULAE="python@3.15 python-tk@3.15 numpy scipy imagemagick-full d2 cmake ncdu sdl2_image sdl2_mixer sdl2_ttf"
BREW_EXTRA_CASKS="inkscape blender iina pairpods"

# --- pinned ---
KICAD_VERSION=10.0.7                 # Homebrew cask "kicad" on the reference Mac
KICAD_DMG_URL=https://github.com/KiCad/kicad-source-mirror/releases/download/10.0.7/kicad-unified-universal-10.0.7.dmg
KICAD_DMG_SHA256=fbc27419b841a9a2a8b143b5875a87b8bd943ffcf487d53c78a8fb6d24c59e27
KICAD_APP=/Applications/KiCad/KiCad.app
KICAD_PY=/Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/bin/python3   # 3.9.13, has pcbnew

KRT_URL=https://github.com/drandyhaas/KiCadRoutingTools.git
KRT_COMMIT=e91017d121e4455f997eca056b8747c890f28bcc     # main, 2026-11-02 (v0.23.7-430)
KRT_ROUTER_TAG=v0.23.7               # rust_router/ is unchanged from this tag to KRT_COMMIT
KRT_ROUTER_SHA256=4ef094676987c68a2f3c9d8d43eaf6eabde909846ad448fc7233ab6b2366645e   # grid_router-macos-arm64.so
KRT_PYTHON=3.12.16                   # uv-managed CPython
KRT_VENV_REL=.cache/dropout/krt-venv # under $HOME
KRT_DIR_REL=Dev/KiCadRoutingTools    # under $HOME

# Repos under ~/Dev (cloned only when missing; an existing checkout is never touched).
# name|GitHub repo
REPOS="node60-hw|karlTbowers/node60-hw
dropout-hardware-handbook|karlTbowers/dropout-hardware-handbook
dropout-kicad-library|karlTbowers/dropout-kicad-library
dropout-vendor-docs|karlTbowers/dropout-vendor-docs
ee-skills|charlesh97/ee-skills"

# The commit the reference judging run was measured at (scripts/workstation/reference/).
REF_JUDGE_REF=origin/placement/routing-readiness
REF_JUDGE_COMMIT=b6d7085
