	(text "Switched bus termination and relay driver (K501, Q501-Q502, R516-R522, C514)"
		(exclude_from_sim no)
		(at 411.48 143.51 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.3)
				bold
			)
			(justify left bottom)
		)
		(uuid "de65f745-fc8a-484a-ac6c-ff02bdfe570c")
	)
	(text "DEC-017 (OPEN Alliance 10BASE-T1S impl. spec 6.4.1; Microchip AN1718 rev D). Relay holds its state with no power.\nSET (pin 1 +, pin 8 -) = END NODE: COM-SET closed, 49.9R 1 % legs (R517, R519) -> 100R across the pair.\nRESET (factory state) = DROP NODE: COM-RST closed, 1.5k legs (R516, R518) = common-mode termination.\nCentre tap: C514 100nF 100V || R520 100k to GND. Contact resistance 100 mOhm max (0.2 % of a leg).\nDrive: T1S_TERM_END high >= 10 ms -> Q501 pulls pin 8 low -> SET. T1S_TERM_DROP high -> Q502 pulls pin 1 low -> RESET.\n  Never both high. Idle: both low (R521/R522), both coil ends at 3V3_MAIN, no current. Coil 64R, 46.6 mA.\nFirmware: state stored in flash, restored with one 10 ms pulse at every cold boot (DEC-017).\nLAYOUT: K501 and legs in line on the pair next to the ESD, short symmetric stubs; no ground pour around them."
		(exclude_from_sim no)
		(at 500.38 210.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2beb8721-4ce4-4a15-82de-ef744c5a4ddf")
	)
