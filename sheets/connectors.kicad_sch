	(text "SurLok Plus SLPRATPSR (red) screws into each terminal (M6, 3 N-m; REDCUBE max 3.9 N-m).\nBusbar inside the case joins J901 and J910: one side feeds this node, the other a downstream node.\nPASS-THROUGH is raw battery: it bypasses the LM74910H breaker and the INA228 shunt (DEC-016).\nLAYOUT: 60 A plus the downstream current; Ø9.3 non-plated hole per terminal; hold while tightening."
		(exclude_from_sim no)
		(at 68.58 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "35da6a75-13b3-41c7-ba00-a9f3a383df81")
	)
	(text "SurLok Plus SLPRATPSB (black) screws into each terminal. Busbar inside the case joins J902 and J911.\nCarries all six load returns (up to 60 A) plus the downstream node's return (DEC-013, DEC-016).\nLAYOUT: same copper and via treatment as VBAT_IN; returns join at the power-entry star region."
		(exclude_from_sim no)
		(at 76.2 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f98a07fe-f0d2-44d9-86dd-70590b837e53")
	)
	(embedded_fonts no)
