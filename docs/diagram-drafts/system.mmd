%%{init: {"flowchart": {"htmlLabels": true, "curve": "basis"}, "securityLevel": "loose"}}%%
flowchart TB
  subgraph harness["4-wire harness"]
    port["<b>Node connector</b><br/>T1S pair · battery · ground"]
  end

  subgraph battery_domain["Battery domain · always connected"]
    entry["<b>Power entry</b><br/>LM74910H-Q1 · 0.25 mΩ RSENSE<br/>INA228A-Q1 · XLD8A24CA TVS"]
    aon["<b>Always-on supply</b><br/>nanopower LDO → VDDAU<br/>≈50 µA parked"]
  end

  subgraph logic["Switched logic · enabled by PHY INH"]
    rails["<b>Main rails</b><br/>2 × LMQ66430-Q1<br/>3V3_MAIN · 1V5_CORE · TPS3702-Q1"]
    phy["<b>LAN8670D0 PHY</b><br/>10BASE-T1S · TC10 wake<br/>INH gatekeeper"]
    mcu["<b>S32K344 MCU</b><br/>Zephyr · RMII · ADC · SPI"]
    flash["<b>Diagnostic log</b><br/>IS25LP032D-JNLA3<br/>32 Mbit SPI NOR"]
    temp["<b>Temperature sensing</b><br/>TMP175-Q1 + 4 NTC"]
  end

  subgraph loads["Switched loads"]
    sw["<b>Output stage</b><br/>3 × TPS2HCS08A-Q1<br/>SPI · SNS · I²t"]
    out["<b>6 × 10 A outputs</b><br/>(target; thermal gate open)"]
  end

  port ==>|"VBAT 60 A"| entry
  entry ==>|"VBAT_PROT"| aon
  entry ==>|"VBAT_PROT"| rails
  entry ==>|"VBAT_PROT 60 A"| sw
  sw ==> out

  aon -->|"VDDAU"| phy
  phy -->|"INH → EN"| rails
  rails -->|"3V3 · 1V5"| mcu

  port <-->|"T1S wake + data"| phy
  phy <-->|"RMII + MDIO"| mcu
  mcu -->|"SPI"| flash
  mcu -->|"SPI chain · SNS · FLT"| sw
  mcu <-->|"I²C · FLT · BATT_MON"| entry
  mcu <-->|"I²C · ADC"| temp

  classDef battery fill:#fff2d9,stroke:#bd6b00,stroke-width:2px,color:#13283a
  classDef aon fill:#e2f3f1,stroke:#087c77,stroke-width:2px,color:#13283a
  classDef compute fill:#e6f1f7,stroke:#176a96,stroke-width:2px,color:#13283a
  classDef network fill:#efeaf4,stroke:#735590,stroke-width:2px,color:#13283a
  classDef loads fill:#fce9e6,stroke:#a9392d,stroke-width:2px,color:#13283a
  class entry battery
  class aon,rails aon
  class mcu,flash,temp compute
  class port,phy network
  class sw,out loads

  linkStyle 0,1,2,3,4 stroke:#bd6b00,stroke-width:4px
  linkStyle 5,6,7 stroke:#087c77,stroke-width:2px
  linkStyle 8,9 stroke:#735590,stroke-width:2px
  linkStyle 10,11,12,13 stroke:#176a96,stroke-width:2px

  click port href "#harness"
  click entry href "#power"
  click aon href "#power"
  click rails href "#power"
  click phy href "#network"
  click mcu href "#compute"
  click flash href "#firmware"
  click temp href "#temperature"
  click sw href "#outputs"
  click out href "#outputs"
  style harness fill:#f7f9fa,stroke:#a8bac6,stroke-dasharray:4 4,color:#536776
  style battery_domain fill:#f7f9fa,stroke:#a8bac6,stroke-dasharray:4 4,color:#536776
  style logic fill:#f7f9fa,stroke:#a8bac6,stroke-dasharray:4 4,color:#536776
  style loads fill:#f7f9fa,stroke:#a8bac6,stroke-dasharray:4 4,color:#536776
