direction: down

vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}

classes: {
  battery: {style: {fill: "#fff2d9"; stroke: "#bd6b00"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  aon: {style: {fill: "#e2f3f1"; stroke: "#087c77"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  compute: {style: {fill: "#e6f1f7"; stroke: "#176a96"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  network: {style: {fill: "#efeaf4"; stroke: "#735590"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  loads: {style: {fill: "#fce9e6"; stroke: "#a9392d"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  group: {style: {fill: "#f7f9fa"; stroke: "#a8bac6"; stroke-dash: 4; border-radius: 10; font-color: "#536776"; font-size: 15}}
  power: {style: {stroke: "#bd6b00"; stroke-width: 4; font-color: "#bd6b00"}}
  rail: {style: {stroke: "#087c77"; stroke-width: 2; font-color: "#087c77"}}
  signal: {style: {stroke: "#176a96"; stroke-width: 2; font-color: "#176a96"}}
  net: {style: {stroke: "#735590"; stroke-width: 2; font-color: "#735590"}}
}

harness: "4-wire harness" {
  class: group
  port: "Node connector\nT1S pair · battery · ground" {class: network; link: "#harness"}
}

battery_domain: "Battery domain · always connected" {
  class: group
  entry: "Power entry\nLM74910H-Q1 · 0.25 mΩ RSENSE\nINA228A-Q1 · XLD8A24CA TVS" {class: battery; link: "#power"}
  aon: "Always-on supply\nnanopower LDO → VDDAU\n≈50 µA parked" {class: aon; link: "#power"}
}

logic: "Switched logic · enabled by PHY INH" {
  class: group
  rails: "Main rails\n2 × LMQ66430-Q1\n3V3_MAIN · 1V5_CORE · TPS3702-Q1" {class: aon; link: "#power"}
  phy: "LAN8670D0 PHY\n10BASE-T1S · TC10 wake\nINH gatekeeper" {class: network; link: "#network"}
  mcu: "S32K344 MCU\nZephyr · RMII · ADC · SPI" {class: compute; link: "#compute"}
  flash: "Diagnostic log\nIS25LP032D-JNLA3\n32 Mbit SPI NOR" {class: compute; link: "#firmware"}
  temp: "Temperature sensing\nTMP175-Q1 + 4 NTC" {class: compute; link: "#temperature"}
}

loads: "Switched loads" {
  class: group
  sw: "Output stage\n3 × TPS2HCS08A-Q1\nSPI · SNS · I²t" {class: loads; link: "#outputs"}
  out: "6 × 10 A outputs\n(target; thermal gate open)" {class: loads; link: "#outputs"}
}

harness.port -> battery_domain.entry: "VBAT 60 A" {class: power}
battery_domain.entry -> battery_domain.aon: "VBAT_PROT" {class: power}
battery_domain.entry -> logic.rails: "VBAT_PROT" {class: power}
battery_domain.entry -> loads.sw: "VBAT_PROT 60 A" {class: power}
loads.sw -> loads.out {class: power}

battery_domain.aon -> logic.phy: "VDDAU" {class: rail}
logic.phy -> logic.rails: "INH → EN" {class: rail}
logic.rails -> logic.mcu: "3V3 · 1V5" {class: rail}

harness.port <-> logic.phy: "T1S wake + data" {class: net}
logic.phy <-> logic.mcu: "RMII + MDIO" {class: net}
logic.mcu -> logic.flash: "SPI" {class: signal}
logic.mcu -> loads.sw: "SPI chain · SNS · FLT" {class: signal}
logic.mcu <-> battery_domain.entry: "I²C · FLT · BATT_MON" {class: signal}
logic.mcu <-> logic.temp: "I²C · ADC" {class: signal}
