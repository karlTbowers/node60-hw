# Node60 · Signal architecture, digital and analog (Architecture Rev A)
# Inputs on the left, MCU in the middle, outputs on the right.
# Solid = digital (purple: network, blue: control buses). Dashed green = analog into the MCU ADC.
# Every block links to its subsystem page (site-relative; the D2Diagram component adds the base path).

direction: right

vars: {
  d2-config: {
    layout-engine: elk
  }
}

classes: {
  external: {style: {fill: "#f1f4f6"; stroke: "#7d8f9b"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  network: {style: {fill: "#efeaf4"; stroke: "#735590"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  compute: {style: {fill: "#e6f1f7"; stroke: "#176a96"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  sense: {style: {fill: "#e8f3ec"; stroke: "#317151"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  battery: {style: {fill: "#fff2d9"; stroke: "#bd6b00"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  load: {style: {fill: "#fce9e6"; stroke: "#a9392d"; stroke-width: 2; border-radius: 8; font-color: "#13283a"}}
  group: {style: {fill: "#f7f9fa"; stroke: "#a8bac6"; stroke-dash: 4; border-radius: 10; font-color: "#536776"; font-size: 15}}
  net: {style: {stroke: "#735590"; stroke-width: 3; font-color: "#735590"}}
  dig: {style: {stroke: "#176a96"; stroke-width: 2; font-color: "#176a96"}}
  ana: {style: {stroke: "#317151"; stroke-width: 2; stroke-dash: 5; font-color: "#317151"}}
}

network: "10BASE-T1S" {
  class: group
  ecu: "Controller ECU\nPLCA coordinator\nsole wake source" {class: external; link: "/subsystems/harness/"}
  line: "Line interface\n2 × 100 nF · ESD pair\nswitchable 100 Ω termination" {class: network; link: "/subsystems/network/"}
  phy: "LAN8670D0\nPLCA follower · TC10 wake" {class: network; link: "/subsystems/network/"}
  osc: "50 MHz oscillator\nECS-3225SMVQ" {class: network; link: "/subsystems/network/"}
}

sensing: "Measurement inputs" {
  class: group
  lm: "LM74910H-Q1\ninput protection" {class: battery; link: "/subsystems/power/"}
  rsense: "RSENSE 0.25 mΩ" {class: battery; link: "/subsystems/power/"}
  div: "SW-pin OV/UV divider\n1:12 · VBAT_RAW" {class: sense; link: "/subsystems/power/"}
  ina: "INA228A-Q1\n20-bit total I · V · P" {class: sense; link: "/subsystems/power/"}
  tmp: "TMP175-Q1\nNFET-bank temperature" {class: sense; link: "/subsystems/temperature/"}
  ntc: "4 × 10 kΩ NTC dividers\nRSENSE · SW1 · SW2 · SW3" {class: sense; link: "/subsystems/temperature/"}
  sup: "TPS3702-Q1\n3V3 OV/UV supervisor" {class: compute; link: "/subsystems/supervision/"}
}

mcu: "S32K344\nLPSPI ×2 · LPI2C · 12-bit ADC · GPIO\ninternal SWT watchdog · CMU" {class: compute; link: "/subsystems/compute/"}

outputs: "Controlled devices" {
  class: group
  sw: "3 × TPS2HCS08A-Q1\nSPI daisy chain with CRC\nLHI held inactive" {class: load; link: "/subsystems/outputs/"}
  flash: "IS25LP032D-JNLA3\n32 Mbit diagnostic log" {class: compute; link: "/subsystems/firmware/"}
  dbg: "SWD/JTAG + UART pads\ninternal service only" {class: compute; link: "/subsystems/compute/"}
}

network.ecu <-> network.line: "T1S pair" {class: net}
network.line <-> network.phy: "TRXP/N" {class: net}
network.osc -> network.phy: "REF_CLK" {class: dig}
network.phy <-> mcu: "RMII + MDC/MDIO" {class: net}
network.phy -> mcu: "IRQ_N" {class: dig}

sensing.rsense -- sensing.ina: "Kelvin IN+/IN−" {class: ana}
sensing.lm -- sensing.div: "SW pin" {class: ana}
sensing.div -- mcu: "BATT_MON → ADC" {class: ana}
sensing.ntc -- mcu: "4 × → ADC" {class: ana}
sensing.ina <-> mcu: "LPI2C" {class: dig}
sensing.tmp <-> mcu: "LPI2C · ALERT" {class: dig}
sensing.lm -> mcu: "FLT" {class: dig}
sensing.sup -> mcu: "RESET_b" {class: dig}

mcu -> outputs.sw: "LPSPI #1 · shared CSN/SCLK" {class: dig}
mcu <-> outputs.sw: "3 × FLT/WAKE" {class: dig}
mcu -- outputs.sw: "3 × SNS → ADC (698 Ω + filter)" {class: ana}
mcu -> outputs.flash: "LPSPI #2" {class: dig}
mcu <-> outputs.dbg: "SWD · UART" {class: dig}
